% symbols
% 'letters' avoids the FontAwesome icon glyphs (Private-Use-Area codepoints
% that many ATS resume parsers cannot render) in favor of plain text labels
\moderncvicons{letters}


%-------------------------------------------------------------------------------
%                header, body & footer
%-------------------------------------------------------------------------------
%\moderncvhead{3}
\moderncvhead{3}
\moderncvbody{4}

% \namefont/\titlefont default to \Huge, whose 30pt \baselineskip is what
% moderncv uses to space the line break before the contact-info line below
% the name -- that 30pt gap is much bigger than the small addressfont line
% actually needs. Keep the same 25pt visual size but with a tighter skip.
\renewcommand*{\namefont}{\fontsize{25pt}{20pt}\selectfont\bfseries\upshape}
\renewcommand*{\titlefont}{\fontsize{25pt}{20pt}\selectfont\mdseries\upshape}


% Add a full-width rule below each section title
\RenewDocumentCommand{\section}{sm}{%
  \par\addvspace{2.5ex}%
  \phantomsection{}%
  \addcontentsline{toc}{section}{#2}%
  \strut\sectionstyle{#2}%
  \sectionrule
  \par\nobreak\addvspace{1ex}\@afterheading}

% Add a full-width rule below each section title
\newcommand*{\sectionrule}{%
  \par\nobreak\vspace*{-.7\baselineskip}%
  \leavevmode{\color{color1}\leaders\hbox{\rule{1pt}{0.4pt}}\hfill\kern0pt}}

\colorlet{skillmatrixfullcolor}{color1}
\colorlet{skillmatrixemptycolor}{color2!30}

\colorlet{lastnamecolor}{color2}
\colorlet{namecolor}{lastnamecolor}
\colorlet{headrulecolor}{lastnamecolor!50}
\colorlet{firstnamecolor}{lastnamecolor!50}
\colorlet{titlecolor}{color2}
\colorlet{addresscolor}{color2}

\colorlet{sectioncolor}{color1}
\colorlet{subsectioncolor}{color1}
\colorlet{hintstylecolor}{color0}

\endinput


